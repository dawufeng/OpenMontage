{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reference_style_review",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference_shot_id": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unknown"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "reference_shot_id",
          "event_id",
          "status",
          "evidence_paths",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "output_path",
    "checks"
  ],
  "additionalProperties": false
}
